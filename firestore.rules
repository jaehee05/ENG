rules_version = '2';

// IMPORTANT: This project intentionally bypasses Firebase Authentication.
// Account credentials live in the `users` collection as PLAINTEXT (by
// explicit user request), and all sessions are local-only (localStorage).
// As a consequence, Firestore Security Rules cannot enforce per-user
// access at the rule layer (there is no request.auth). Anyone with the
// Firebase web config — which is public — can read or write the entire
// database. Do not store anything sensitive here.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
